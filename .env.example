# dsh-voice-polish — standalone service configuration template
#
# Copy the values you need into your shell, or copy this file to `.env`.
# EVERY value below is a placeholder: no real credential lives in this repo.

# ---------------------------------------------------------------------------
# Polish model — OpenAI-compatible /chat/completions
# ---------------------------------------------------------------------------
# Verified working: https://api.deepseek.com with model deepseek-flash (314 ms).
VP_LLM_BASE_URL=https://api.deepseek.com
VP_LLM_API_KEY=sk-REPLACE-WITH-YOUR-KEY
VP_LLM_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# Speech recognition — provider switch
# ---------------------------------------------------------------------------
# local = on-device SenseVoice (offline, free, no key)   [wired in P2]
# cloud = OpenAI-compatible /audio/transcriptions        [available now]
VP_ASR=local

# Cloud ASR credentials are deliberately INDEPENDENT of the LLM ones:
# the LLM vendor may have no transcription endpoint at all (DeepSeek does not),
# and falling back would send your LLM key to a different company.
VP_ASR_BASE_URL=https://api.openai.com/v1
VP_ASR_API_KEY=
VP_ASR_MODEL=whisper-1

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
VP_PORT=8787
# Optional shared secret: when set, every request must send
# `Authorization: Bearer <VP_TOKEN>`.
VP_TOKEN=

# ---------------------------------------------------------------------------
# Quick checks
# ---------------------------------------------------------------------------
#   node service/cli.js --selftest        offline, needs no key
#   node service/cli.js --asr-check local  is the local recogniser ready?
#   node service/cli.js --asr-check cloud  are the cloud ASR vars set?
#   node service/server.js                 start the HTTP API
