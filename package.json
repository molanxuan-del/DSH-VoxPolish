{
  "name": "dsh-voice-polish",
  "version": "1.0.0",
  "description": "「声琢」VoxPolish — 把说出来的话打磨成清晰表达：原话/整理后双通道，先说后改再发送，全程不碰输入框。Voice input with an expression coach for DeepSeek Harness; local SenseVoice ASR, no extra model download.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "voice",
    "voice-input",
    "speech-to-text",
    "prompt",
    "prompt-engineering",
    "expression",
    "transcription",
    "sensevoice",
    "voxpolish"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "author": "molanxuan-del <2954567135@qq.com>",
  "homepage": "https://github.com/molanxuan-del/DSH-VoxPolish#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molanxuan-del/DSH-VoxPolish.git"
  },
  "bugs": {
    "url": "https://github.com/molanxuan-del/DSH-VoxPolish/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/parse.test.mjs test/service.test.mjs test/client-contract.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
